{
  "expo": {
    "name": "Atelier Tracker",
    "slug": "ResolutionTracker",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F3EC"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.andresbotia.ResolutionTracker",
      "buildNumber": "7",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.andresbotia.yearlytracker",
      "versionCode": 18,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F6F3EC"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "bf908a4e-0a56-49b5-b997-04c44ffa4666"
      }
    },
    "plugins": [
      "expo-font"
    ]
  }
}
