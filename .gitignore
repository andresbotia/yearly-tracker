# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native / keys
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store

# local env files
.env*.local

# typescript
*.tsbuildinfo

# ----------------------------
# iOS (we TRACK ios/ but ignore local/build artifacts)
# ----------------------------
ios/Pods/
ios/build/
ios/DerivedData/
ios/xcuserdata/
ios/**/*.xcuserstate
ios/.xcode.env.local
ios/**/.xcode.env
ios/**/*.bak.*
ios/**/*.DISABLED
*.ipa
*.xcarchive
*.dSYM*
*.dSYM.zip

# ----------------------------
# Android (we TRACK android/ but ignore artifacts)
# ----------------------------
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/**/*.iml
android/**/*.hprof
android/.cxx/
android/app/debug.keystore


# Bundle artifacts
*.jsbundle

# Art pipeline cache (masters stay out of the app bundle)
scripts/.art-cache/

# Temporary Claude brand handoff (do not commit)
Atelier Tracker rebranding.zip
.tmp-brand-handoff/
