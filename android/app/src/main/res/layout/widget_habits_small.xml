<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="12dp">

  <TextView
    android:id="@+id/title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Habits"
    android:textStyle="bold"
    android:textSize="14sp"
    android:maxLines="1"
    android:textColor="@android:color/white"
    android:ellipsize="end" />

  <TextView android:id="@+id/line1" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="10dp" android:text="-" android:textSize="12sp" android:textColor="@android:color/white"
    android:maxLines="1" android:ellipsize="end" />
  <TextView android:id="@+id/line2" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="6dp" android:text="-" android:textSize="12sp" android:textColor="@android:color/white"
    android:maxLines="1" android:ellipsize="end" />
  <TextView android:id="@+id/line3" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="6dp" android:text="-" android:textSize="12sp" android:textColor="@android:color/white"
    android:maxLines="1" android:ellipsize="end" />
  <TextView android:id="@+id/line4" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="6dp" android:text="-" android:textSize="12sp" android:textColor="@android:color/white"
    android:maxLines="1" android:ellipsize="end" />
  <TextView android:id="@+id/line5" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="6dp" android:text="-" android:textSize="12sp" android:textColor="@android:color/white"
    android:maxLines="1" android:ellipsize="end" />
  <TextView android:id="@+id/line6" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="6dp" android:text="-" android:textSize="12sp" android:textColor="@android:color/white"
    android:maxLines="1" android:ellipsize="end" />
  <TextView android:id="@+id/line7" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="6dp" android:text="-" android:textSize="12sp" android:textColor="@android:color/white"
    android:maxLines="1" android:ellipsize="end" />
  <TextView android:id="@+id/line8" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="6dp" android:text="-" android:textSize="12sp" android:textColor="@android:color/white"
    android:maxLines="1" android:ellipsize="end" />

  <TextView
    android:id="@+id/moreLine"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:text="... +0 more"
    android:textSize="12sp"
    android:textColor="@android:color/white"
    android:alpha="0.8"
    android:maxLines="1"
    android:ellipsize="end" />

</LinearLayout>
