<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="#F6F3EC">

  <ImageView
    android:id="@+id/artwork"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scaleType="centerCrop"
    android:contentDescription="@null"
    android:visibility="gone" />

  <View
    android:id="@+id/veil"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#96F6F3EC"
    android:visibility="gone" />

  <LinearLayout
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
      android:id="@+id/kickerRow"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical">
      <ImageView
        android:id="@+id/brandMark"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/atelier_mark_24"
        android:contentDescription="@null" />
      <TextView
        android:id="@+id/kicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="/ TODAY"
        android:textAllCaps="true"
        android:fontFamily="monospace"
        android:textSize="10sp"
        android:letterSpacing="0.08"
        android:textColor="#9B1C1916" />
    </LinearLayout>

    <TextView
      android:id="@+id/title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:text="HABITS"
      android:textAllCaps="true"
      android:fontFamily="monospace"
      android:textSize="10sp"
      android:letterSpacing="0.08"
      android:textColor="#1C1916" />

    <TextView android:id="@+id/line1" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="8dp" android:text="-" android:textSize="13sp" android:fontFamily="monospace"
      android:textColor="#1C1916" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/line2" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="5dp" android:text="-" android:textSize="13sp" android:fontFamily="monospace"
      android:textColor="#1C1916" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/line3" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="5dp" android:text="-" android:textSize="13sp" android:fontFamily="monospace"
      android:textColor="#1C1916" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/line4" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="5dp" android:text="-" android:textSize="13sp" android:fontFamily="monospace"
      android:textColor="#1C1916" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/line5" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="5dp" android:text="-" android:textSize="13sp" android:fontFamily="monospace"
      android:textColor="#1C1916" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/line6" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="5dp" android:text="-" android:textSize="13sp" android:fontFamily="monospace"
      android:textColor="#1C1916" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/line7" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="5dp" android:text="-" android:textSize="13sp" android:fontFamily="monospace"
      android:textColor="#1C1916" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/line8" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="5dp" android:text="-" android:textSize="13sp" android:fontFamily="monospace"
      android:textColor="#1C1916" android:maxLines="1" android:ellipsize="end" />

    <TextView
      android:id="@+id/moreLine"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:text=""
      android:textSize="12sp"
      android:fontFamily="monospace"
      android:textColor="#9B1C1916"
      android:maxLines="1"
      android:ellipsize="end" />
  </LinearLayout>
</FrameLayout>
